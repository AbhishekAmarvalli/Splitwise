# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL) — get a free one from https://neon.com
DATABASE_URL=postgresql://user:password@localhost:5432/splitwise_clone

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend URL(s) for CORS — comma-separated. Leave blank when the API serves
# the built frontend on the same origin.
FRONTEND_URL=http://localhost:5173
